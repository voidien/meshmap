# meshmap settings. Copy this file to .env (optional; the defaults work without it).

# Host port the app is published on (not used with the Tailscale container below).
MESHMAP_PORT=9091

# Optional: Tailscale from a container beside meshmap (docker-compose.tailscale.yml). It joins your tailnet as its own
# machine and serves https://<TS_HOSTNAME>.<your tailnet>.ts.net; nothing listens on this server's port any more.
# Uncomment both lines, then `docker compose up -d`. The README's "Tailscale from a container" says what to turn on
# in Tailscale first and how to make the key.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=meshmap
# serve = only devices on your tailnet (default); funnel = anyone on the internet. meshmap has no login, so keep serve
# unless you mean it.
# TS_MODE=serve
