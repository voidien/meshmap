# Copy to .env in this directory (never commit it).

# Auth key from https://login.tailscale.com/admin/settings/keys
# Use a reusable key (optionally tagged, e.g. tag:meshmap); it is only needed on first start,
# the node identity is then kept in the tailscale-state volume.
TS_AUTHKEY=

# Name of the machine on your tailnet -> https://meshmap.<your-tailnet>.ts.net
TS_HOSTNAME=meshmap

# serve  = reachable only from devices on your tailnet (default, recommended)
# funnel = reachable from the public internet through Tailscale Funnel
TS_MODE=serve
